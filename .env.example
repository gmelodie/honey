# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cowrie
POSTGRES_USER=cowrie
POSTGRES_PASSWORD=change-me-strong-password

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────────────
# Register at https://www.google.com/recaptcha/admin/create (type: v3). Leave blank to disable the gate.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Nginx routing ─────────────────────────────────────────────────────────────
# Requests with this Host header go to the stats dashboard. Nginx drops all other hosts.
TARGET_HOST=honey.example.com

# ── Let's Encrypt ─────────────────────────────────────────────────────────────
# Used by scripts/init-letsencrypt.sh  (not read by docker-compose directly)
CERTBOT_EMAIL=you@example.com
